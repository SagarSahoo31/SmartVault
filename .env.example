# SmartVault Environment Variables
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartvault
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_NAME=smartvault:security_events
SECRET_KEY=smartvault-dev-secret-key-change-in-production-32bytes
STORAGE_DIR=./storage
SESSION_COOKIE_NAME=smartvault_session
SESSION_COOKIE_SECURE=false
SESSION_EXPIRE_HOURS=24
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
EVENT_CONSUMER_KEY=smartvault-local-consumer
RESEND_API_KEY=re_placeholder_key
SENDER_EMAIL=onboarding@resend.dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
